# Optionnel : uniquement pour le serveur Node, jamais de préfixe VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Générez un code aléatoire d'au moins 32 caractères et saisissez-le dans Données & services.
APP_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=3001
# En déploiement HTTPS, définir l'origine publique exacte.
APP_ORIGIN=
