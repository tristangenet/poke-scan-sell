{
  "manifest_version": 3,
  "name": "Poke Scan Sell — Vinted",
  "version": "0.2.9",
  "description": "Transfère votre annonce et vos photos depuis Poke Scan Sell vers le formulaire Vinted.",
  "key": "",
  "permissions": ["alarms", "unlimitedStorage"],
  "host_permissions": ["https://www.vinted.fr/*", "https://vinted.fr/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": ["http://localhost/*", "http://127.0.0.1/*"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.vinted.fr/*", "https://vinted.fr/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
